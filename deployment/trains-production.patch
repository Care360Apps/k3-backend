new file mode 100644
index 00000000..8a6d3217
--- /dev/null
+++ b/app/Console/Commands/PrivatizeCourseImages.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\Course;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\File;
+use Illuminate\Support\Str;
+
+class PrivatizeCourseImages extends Command
+{
+    protected $signature = 'trains:privatize-images {--apply : Copy legacy images and update course references}';
+    protected $description = 'Audit or copy legacy course images into private storage without deleting shared public files';
+
+    public function handle(): int
+    {
+        $failures = 0;
+        $root = realpath(public_path('images/upload'));
+        foreach (Course::withTrashed()->whereNotNull('image')->cursor() as $course) {
+            $name = $course->image;
+            if (!$name || str_starts_with($name, 'trains-')) {
+                continue;
+            }
+            if (!preg_match('/^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,199}\.(png|jpe?g|gif|webp)$/iD', $name)) {
+                $this->warn("Invalid legacy image for course {$course->id}");
+                $failures++;
+                continue;
+            }
+            $source = public_path('images/upload/'.$name);
+            $resolved = realpath($source);
+            if (!$root || !$resolved || is_link($source) || !str_starts_with($resolved, $root.DIRECTORY_SEPARATOR) || !is_file($resolved)) {
+                $this->warn("Missing or unsafe legacy image for course {$course->id}");
+                $failures++;
+                continue;
+            }
+            $mime = (@getimagesize($resolved))['mime'] ?? '';
+            $extensions = ['image/jpeg'=>'jpg','image/png'=>'png','image/gif'=>'gif','image/webp'=>'webp'];
+            if (!isset($extensions[$mime])) {
+                $this->warn("Invalid image content for course {$course->id}");
+                $failures++;
+                continue;
+            }
+            $this->line("Legacy course {$course->id}: {$name}");
+            if (!$this->option('apply')) {
+                continue;
+            }
+            $directory = storage_path('app/course-images');
+            File::ensureDirectoryExists($directory);
+            $new = 'trains-'.Str::uuid().'.'.$extensions[$mime];
+            if (!File::copy($resolved, $directory.'/'.$new)) {
+                $failures++;
+                continue;
+            }
+            $changed = Course::withTrashed()->whereKey($course->id)->where('image',$name)->update(['image'=>$new]);
+            if (!$changed) {
+                File::delete($directory.'/'.$new);
+                $failures++;
+            }
+        }
+        $this->warn('Original public files are retained. Verify shared references and remove or deny direct access to legacy files before release.');
+        return $failures ? self::FAILURE : self::SUCCESS;
+    }
+}
diff --git a/app/Http/Controllers/CourseImageController.php b/app/Http/Controllers/CourseImageController.php
new file mode 100644
index 00000000..b3343e44
--- /dev/null
+++ b/app/Http/Controllers/CourseImageController.php
@@ -0,0 +1,42 @@
+<?php
+namespace App\Http\Controllers;
+
+use App\Models\Course;
+
+final class CourseImageController extends Controller
+{
+    public function show(string $filename)
+    {
+        abort_unless(preg_match('/^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,199}\.(png|jpe?g|gif|webp)$/iD',$filename),404);
+        $published=Course::where('image',$filename)->where('is_published',true)->exists();
+        abort_unless($published,404);
+        return $this->serve($filename);
+    }
+
+    public function preview(int $id)
+    {
+        abort_unless(\Illuminate\Support\Facades\Gate::allows('course_access') || \Illuminate\Support\Facades\Gate::allows('course_edit'),403);
+        $course = Course::withTrashed()->findOrFail($id);
+        return $this->serve((string) $course->image);
+    }
+
+    private function serve(string $filename)
+    {
+        abort_unless(preg_match('/^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,199}\.(png|jpe?g|gif|webp)$/iD',$filename),404);
+        $directory = storage_path('app/course-images');
+        // Legacy files remain readable until administrators replace them.
+        if (!str_starts_with($filename, 'trains-') && !file_exists($directory.'/'.$filename)) {
+            $directory = public_path('images/upload');
+        }
+        $root=realpath($directory);
+        $path=$directory.'/'.$filename;$resolved=realpath($path);
+        abort_unless($root && $resolved && !is_link($path) && str_starts_with($resolved,$root.DIRECTORY_SEPARATOR)
+            && is_file($resolved) && is_readable($resolved),404);
+        $info=@getimagesize($resolved);$mime=$info['mime'] ?? '';
+        abort_unless(in_array($mime,['image/png','image/jpeg','image/gif','image/webp'],true),404);
+        return response()->file($resolved,[
+            'Content-Type'=>$mime,'X-Content-Type-Options'=>'nosniff',
+            'Cache-Control'=>'no-store',
+        ]);
+    }
+}
