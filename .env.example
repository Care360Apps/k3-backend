APP_NAME=K3-Staging
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
# Configure further application-specific integration variables in a local, untracked .env

# Disabled until chat notification authorization and OneSignal staging checks pass
K3_CHAT_PUSH_ENABLED=false

# Optional: only for authenticated Places New address search via Laravel proxy.
# Do not use the Android Maps SDK key. Keep this server-only and IP-restricted.
K3_PLACES_SERVER_API_KEY=
